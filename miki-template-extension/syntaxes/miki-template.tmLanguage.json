{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "miki-template",
  "scopeName": "text.html.miki",
  "fileTypes": ["miki", "miki-template", "html", "django", "dj", "htm", "tpl", "j2", "jinja", "jinja2"],
  "embeddedLanguages": {
    "text.html.basic": "html",
    "meta.tag.any.html": "html",
    "meta.tag.style.html": "css",
    "meta.tag.script.html": "javascript",
    "source.css": "css",
    "source.js": "javascript"
  },
  "tokenColors": [
    {
      "name": "Template Tags",
      "scope": ["entity.name.tag.django"],
      "settings": {
        "foreground": "#0000FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Template Variables (block.super)",
      "scope": ["variable.other.django"],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Template Filter Functions",
      "scope": ["support.function.django"],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Template Strings",
      "scope": ["string.quoted.double.django", "string.quoted.single.django"],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Template Numbers",
      "scope": ["constant.numeric.django"],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Template Language Constants",
      "scope": ["constant.language.django"],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Template Operators",
      "scope": ["keyword.operator.django"],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Template Punctuation",
      "scope": ["punctuation.separator.django", "punctuation.separator.key-value.django"],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Template Comments",
      "scope": ["comment.block.django"],
      "settings": {
        "foreground": "#008000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Template Filter Punctuation",
      "scope": ["punctuation.separator.filter.django", "punctuation.separator.filter-argument.django"],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Prettier Ignore",
      "scope": ["meta.prettier-ignore.django", "meta.prettier-ignore-region.django"],
      "settings": {
        "foreground": "#FFDD00",
        "fontStyle": "italic"
      }
    }
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#prettier-ignore"
    },
    {
      "include": "#prettier-ignore-region"
    },
    {
      "include": "#tag-block"
    },
    {
      "include": "#variable-block"
    },
    {
      "include": "#embedded-html"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.django",
          "begin": "\\{#",
          "end": "#\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.django" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.django" }
          }
        }
      ]
    },
    "prettier-ignore": {
      "name": "meta.prettier-ignore.django",
      "match": "\\{#\\s*prettier-ignore\\s*#\\}",
      "captures": {
        "0": { "name": "comment.block.django" }
      }
    },
    "prettier-ignore-region": {
      "name": "meta.prettier-ignore-region.django",
      "begin": "\\{#\\s*prettier-ignore-start\\s*#\\}",
      "end": "\\{#\\s*prettier-ignore-end\\s*#\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.django" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.django" }
      }
    },
    "tag-block": {
      "name": "meta.tag.django",
      "begin": "(\\{%)(-?|\\s*)",
      "end": "(-?\\s*%\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.django" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.django" }
      },
      "patterns": [
        {
          "name": "entity.name.tag.django",
          "match": "(?i)\\b(if|elif|else|endif|for|empty|endfor|with|endwith|cycle|firstof|comment|endcomment|verbatim|endverbatim|include|extends|block|endblock|partialdef|endpartialdef|partial|load|autoescape|endautoescape|filter|endfilter|spaceless|endspaceless|ifchanged|endifchanged|resetcycle|templatetag|trans|translate|blocktrans|endblocktrans|language|endlanguage|plural|endplural|regroup|widthratio|debug|csrf_token|csp_nonce_attr|static|url|cache|endcache|addtoblock|endaddtoblock|set|endset|now|ifequal|endifequal|ifnotequal|endifnotequal|ssi|thumbnail|endthumbnail|compress|endcompress|placeholder|get_media_prefix|get_static_prefix|endverbatim|verbatin|endverbatin|verbatim_comment|thumbnail_opts|ssi_modified|compress_block)\\b"
        },
        {
          "name": "variable.other.django",
          "match": "[a-zA-Z_][a-zA-Z0-9_.]*"
        },
        {
          "name": "string.quoted.double.django",
          "match": "\"[^\"]*\""
        },
        {
          "name": "string.quoted.single.django",
          "match": "'[^']*'"
        },
        {
          "name": "constant.numeric.django",
          "match": "\\b\\d+\\.?\\d*\\b"
        },
        {
          "name": "constant.language.django",
          "match": "\\b(true|false|null|undefined)\\b"
        },
        {
          "name": "keyword.operator.django",
          "match": "(?i)\\b(and|or|not|in|not in)\\b"
        },
        {
          "name": "punctuation.separator.django",
          "match": "="
        },
        {
          "name": "punctuation.separator.key-value.django",
          "match": "\\b(as)\\b"
        }
      ]
    },
    "variable-block": {
      "name": "meta.variable.django",
      "begin": "(\\{\\{)(-?|\\s*)",
      "end": "(-?\\s*\\}\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.variable.begin.django" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.variable.end.django" }
      },
      "patterns": [
        {
          "include": "#django-variables"
        },
        {
          "include": "#filters"
        }
      ]
    },
    "django-variables": {
      "patterns": [
        {
          "name": "variable.other.django",
          "match": "[a-zA-Z_][a-zA-Z0-9_.]*"
        },
        {
          "name": "string.quoted.double.django",
          "match": "\"[^\"]*\""
        },
        {
          "name": "string.quoted.single.django",
          "match": "'[^']*'"
        },
        {
          "name": "constant.numeric.django",
          "match": "\\b\\d+\\.?\\d*\\b"
        }
      ]
    },
    "filters": {
      "name": "meta.filter.django",
      "begin": "(\\|)",
      "end": "(\\}\\}|\\|$)",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.filter.django" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.separator.filter.django" }
      },
      "patterns": [
        {
          "name": "support.function.django",
          "match": "(?i)\\b(upper|lower|title|capfirst|slugify|wordcount|striptags|truncatewords|truncatechars|truncatewords_html|truncatechars_html|linebreaks|linebreaksbr|cut|addslashes|removetags|safe|safeseq|escape|escapejs|force_escape|urlencode|escapeuri|escapeurl|urlize|urlizetrunc|iriencode|fix_ampersands|stringformat|center|ljust|rjust|length|length_is|unordered_list|make_list|get_digit|linenumbers|join|slice|first|last|dictsort|dictsortreversed|random|default|default_if_none|firstof|date|time|strftime|date_format|timesince|timeuntil|time_diff|ago|until|add|sub|mult|mod|divisibleby|floatformat|yesno|pluralize|pluralize_either|filesizeformat|trans|regroup|intcomma|intword|apnumber|ordinal|naturalday|naturaldate|naturaltime|lorem|get_digit|phone2numeric|pprint|json_script|json|square|sqrt|abs|round|floor|ceil|min|max|sum|average|reverse|sort|unique|split|replace|base64_encode|base64_decode|range|currency|phone_number|email|mask|whatsapp_link)\\b"
        },
        {
          "name": "punctuation.separator.filter-argument.django",
          "begin": "(:)",
          "end": "(?=\\||\\}\\})",
          "beginCaptures": {
            "1": { "name": "punctuation.separator.filter.argument.django" }
          },
          "patterns": [
            {
              "name": "string.quoted.double.django",
              "match": "\"[^\"]*\""
            },
            {
              "name": "string.quoted.single.django",
              "match": "'[^']*'"
            },
            {
              "name": "constant.numeric.django",
              "match": "\\b\\d+\\.?\\d*\\b"
            },
            {
              "name": "variable.other.django",
              "match": "[a-zA-Z_][a-zA-Z0-9_.]*"
            }
          ]
        }
      ]
    },
    "embedded-html": {
      "patterns": [
        {
          "name": "meta.tag.any.html",
          "begin": "(<)(style)\\b(?=[^>]*>)",
          "end": "(</)(style)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.style.html" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.style.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        },
        {
          "name": "meta.tag.any.html",
          "begin": "(<)(script)\\b(?=[^>]*>)",
          "end": "(</)(script)(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.script.html" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.script.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "name": "text.html.basic",
          "begin": "(<)(?![\\?%])",
          "end": "(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            {
              "name": "entity.name.tag.html",
              "match": "\\/?([a-zA-Z][a-zA-Z0-9:-]*)\\/?"
            },
            {
              "name": "meta.attribute.html",
              "begin": "\\b([a-zA-Z:-]+)(?=\\s*=)",
              "beginCaptures": {
                "1": { "name": "entity.other.attribute-name.html" }
              },
              "patterns": [
                {
                  "name": "string.quoted.double.html",
                  "match": "\"([^\"]*)\""
                },
                {
                  "name": "string.quoted.single.html",
                  "match": "'([^']*)'"
                },
                {
                  "name": "string.unquoted.html",
                  "match": "[^\\s>]+"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
