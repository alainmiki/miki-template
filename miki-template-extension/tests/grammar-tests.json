{
  "grammarTests": [
    {
      "name": "Basic template structure",
      "input": "{% extends \"base.html\" %}\n{% block content %}\n{{ title }}\n{% endblock %}",
      "expectedTokens": [
        { "line": 0, "scope": "meta.tag.django" },
        { "line": 0, "scope": "entity.name.tag.django" },
        { "line": 1, "scope": "meta.tag.django" },
        { "line": 2, "scope": "meta.variable.django" },
        { "line": 2, "scope": "variable.other.django" }
      ]
    },
    {
      "name": "If/else/endif tags",
      "input": "{% if user.is_authenticated %}\n  <p>Hello</p>\n{% else %}\n  <p>Login</p>\n{% endif %}",
      "expectedTags": ["if", "else", "endif"]
    },
    {
      "name": "For loop with empty",
      "input": "{% for item in items %}\n  {{ item }}\n{% empty %}\n  No items\n{% endfor %}",
      "expectedTags": ["for", "empty", "endfor"]
    },
    {
      "name": "Filter chain",
      "input": "{{ name|lower|capfirst|truncatewords:10 }}",
      "expectedFilters": ["lower", "capfirst", "truncatewords"]
    },
    {
      "name": "Comment block",
      "input": "{# This is a comment #}",
      "scope": "comment.block.django"
    },
    {
      "name": "Prettier ignore",
      "input": "{# prettier-ignore #}",
      "scope": "meta.prettier-ignore.django"
    },
    {
      "name": "Include with context",
      "input": "{% include \"partial.html\" with user=user %}",
      "expectedTags": ["include"]
    },
    {
      "name": "Partialdef and partial",
      "input": "{% partialdef card %}\n<div>{{ title }}</div>\n{% endpartialdef %}\n{% partial card %}",
      "expectedTags": ["partialdef", "endpartialdef", "partial"]
    },
    {
      "name": "i18n tags",
      "input": "{% trans \"Hello\" %}\n{% blocktrans with name=user.name %}\n  {{ name }}\n{% endblocktrans %}",
      "expectedTags": ["trans", "blocktrans", "endblocktrans"]
    },
    {
      "name": "Operators",
      "input": "{% if user.age >= 18 and user.is_verified or user.is_admin %}",
      "expectedOperators": ["and", "or"]
    },
    {
      "name": "Cycle tag",
      "input": "{% cycle 'odd' 'even' as marker silent %}",
      "expectedTags": ["cycle"]
    },
    {
      "name": "Widthratio",
      "input": "{% widthratio this_value max_value 100 %}",
      "expectedTags": ["widthratio"]
    },
    {
      "name": "Cache tag",
      "input": "{% cache 500 my_key %}\n{{ content }}\n{% endcache %}",
      "expectedTags": ["cache", "endcache"]
    },
    {
      "name": "Spaceless",
      "input": "{% spaceless %}\n  <p>   </p>\n{% endspaceless %}",
      "expectedTags": ["spaceless", "endspaceless"]
    },
    {
      "name": "Autoescape",
      "input": "{% autoescape off %}\n{{ html|safe }}\n{% endautoescape %}",
      "expectedTags": ["autoescape", "endautoescape"]
    },
    {
      "name": "With block",
      "input": "{% with user.profile as profile %}\n  {{ profile.name }}\n{% endwith %}",
      "expectedTags": ["with", "endwith"]
    },
    {
      "name": "Regroup",
      "input": "{% regroup items by category as grouped %}\n{% for group in grouped %}\n  {{ group.grouper }}\n{% endfor %}",
      "expectedTags": ["regroup"]
    },
    {
      "name": "Block.super",
      "input": "{% block content %}\n  {{ block.super }}\n{% endblock %}",
      "expectedTokens": [{ "scope": "variable.other.django" }]
    },
    {
      "name": "CSRF token",
      "input": "{% csrf_token %}",
      "expectedTags": ["csrf_token"]
    },
    {
      "name": "Static tag",
      "input": "{% static \"css/style.css\" %}",
      "expectedTags": ["static"]
    },
    {
      "name": "URL tag",
      "input": "{% url \"home\" user.id %}",
      "expectedTags": ["url"]
    },
    {
      "name": "Debug tag",
      "input": "{% debug %}",
      "expectedTags": ["debug"]
    },
    {
      "name": "Verbatim",
      "input": "{% verbatim %}\n  {{ not_a_variable }}\n  {% not_a_tag %}\n{% endverbatim %}",
      "expectedTags": ["verbatim", "endverbatim"]
    },
    {
      "name": "Filter block",
      "input": "{% filter upper %}\n  {{ name }}\n{% endfilter %}",
      "expectedTags": ["filter", "endfilter"]
    },
    {
      "name": "Template tag symbol",
      "input": "{% templatetag openblock %}",
      "expectedTags": ["templatetag"]
    },
    {
      "name": "Addtoblock",
      "input": "{% addtoblock css %}\n.selector { color: red; }\n{% endaddtoblock %}",
      "expectedTags": ["addtoblock", "endaddtoblock"]
    },
    {
      "name": "Set block",
      "input": "{% set var = value %}\n{% endset %}",
      "expectedTags": ["set", "endset"]
    },
    {
      "name": "Now tag",
      "input": "{% now \"DATE_FORMAT\" %}",
      "expectedTags": ["now"]
    },
    {
      "name": "Ifchanged block",
      "input": "{% ifchanged %}\n  {{ date }}\n{% endifchanged %}",
      "expectedTags": ["ifchanged", "endifchanged"]
    },
    {
      "name": "Resetcycle",
      "input": "{% resetcycle %}",
      "expectedTags": ["resetcycle"]
    },
    {
      "name": "Get static prefix",
      "input": "{% get_static_prefix %}",
      "expectedTags": ["get_static_prefix"]
    },
    {
      "name": "Get media prefix",
      "input": "{% get_media_prefix %}",
      "expectedTags": ["get_media_prefix"]
    },
    {
      "name": "CSP nonce",
      "input": "<script {% csp_nonce_attr %}>console.log('test')</script>",
      "expectedTags": ["csp_nonce_attr"]
    },
    {
      "name": "Ifequal block",
      "input": "{% ifequal var1 var2 %}\n  Equal\n{% endifequal %}",
      "expectedTags": ["ifequal", "endifequal"]
    },
    {
      "name": "Ifnotequal block",
      "input": "{% ifnotequal var1 var2 %}\n  Not equal\n{% endifnotequal %}",
      "expectedTags": ["ifnotequal", "endifnotequal"]
    },
    {
      "name": "SSI tag",
      "input": "{% ssi \"path/to/file\" %}",
      "expectedTags": ["ssi"]
    },
    {
      "name": "Thumbnail block",
      "input": "{% thumbnail source 100x100 %}\n  img\n{% endthumbnail %}",
      "expectedTags": ["thumbnail", "endthumbnail"]
    },
    {
      "name": "Compress block",
      "input": "{% compress css %}\n  .class { color: red; }\n{% endcompress %}",
      "expectedTags": ["compress", "endcompress"]
    },
    {
      "name": "Placeholder tag",
      "input": "{% placeholder content %}",
      "expectedTags": ["placeholder"]
    },
    {
      "name": "Translate tag",
      "input": "{% translate \"Hello\" %}",
      "expectedTags": ["translate"]
    },
    {
      "name": "Math filters",
      "input": "{{ value|square }}{{ value|sqrt }}{{ value|abs }}{{ list|sum }}{{ list|average }}{{ list|sort }}{{ list|unique }}{{ value|reverse }}",
      "expectedFilters": ["square", "sqrt", "abs", "sum", "average", "sort", "unique", "reverse"]
    },
    {
      "name": "Utility filters",
      "input": "{{ data|json }}{{ value|base64_encode }}{{ value|base64_decode }}{{ list|split:',' }}{{ value|replace:'a,b' }}",
      "expectedFilters": ["json", "base64_encode", "base64_decode", "split", "replace"]
    },
    {
      "name": "Currency and phone filters",
      "input": "{{ value|currency:'$' }}{{ value|phone_number }}{{ value|email }}{{ value|whatsapp_link }}",
      "expectedFilters": ["currency", "phone_number", "email", "whatsapp_link"]
    },
    {
      "name": "Date filters",
      "input": "{{ date|strftime:\"PPpp\" }}{{ date|timesince }}{{ date|timeuntil }}{{ date|time_diff:other }}",
      "expectedFilters": ["strftime", "timesince", "timeuntil", "time_diff"]
    },
    {
      "name": "Natural time filters",
      "input": "{{ date|naturalday }}{{ date|naturaldate }}{{ date|naturaltime }}{{ date|ago }}{{ date|until }}",
      "expectedFilters": ["naturalday", "naturaldate", "naturaltime", "ago", "until"]
    },
    {
      "name": "Humanize filters (planned)",
      "input": "{{ number|intcomma }}{{ number|intword }}{{ number|apnumber }}{{ number|ordinal }}",
      "expectedFilters": ["intcomma", "intword", "apnumber", "ordinal"]
    },
    {
      "name": "Mask and base64 filters",
      "input": "{{ value|mask:'*' }}{{ value|base64_encode }}{{ value|base64_decode }}",
      "expectedFilters": ["mask", "base64_encode", "base64_decode"]
    },
    {
      "name": "Min max filters",
      "input": "{{ value|min:other }}{{ value|max:other }}",
      "expectedFilters": ["min", "max"]
    },
    {
      "name": "Django filter block",
      "input": "{% filter lower %}\n  {{ name }}\n{% endfilter %}",
      "expectedTags": ["filter", "endfilter"]
    },
    {
      "name": "Verbatim with comment content",
      "input": "{% verbatim %}\n  {{ not_a_variable }} {% not_a_tag %}\n{% endverbatim %}",
      "expectedTags": ["verbatim", "endverbatim"]
    },
    {
      "name": "Nested blocks",
      "input": "{% block outer %}{% block inner %}content{% endblock %}{% endblock %}",
      "expectedTags": ["block", "endblock", "endblock"]
    },
    {
      "name": "Multi-line for with if",
      "input": "{% for item in items %}\n{% if item.active %}\n  {{ item.name }}\n{% endif %}\n{% empty %}\nNo items\n{% endfor %}",
      "expectedTags": ["for", "if", "endif", "empty", "endfor"]
    },
    {
      "name": "With multiple variables",
      "input": "{% with a=1 b=2 %}{{ a }} {{ b }}{% endwith %}",
      "expectedTags": ["with", "endwith"]
    },
    {
      "name": "Partial with context",
      "input": "{% partial card with title=\"Hello\" %}",
      "expectedTags": ["partial"]
    }
  ],
  "validationTests": [
    {
      "name": "Unclosed if tag",
      "input": "{% if condition %}\n  content\n{% endfor %}",
      "expectedErrors": ["Unclosed tag: {% if %}"]
    },
    {
      "name": "Mismatched tags",
      "input": "{% if condition %}\n  content\n{% endfor %}",
      "expectedErrors": ["Mismatched tag: expected {% endif %} but found {% endfor %}"]
    },
    {
      "name": "Extends not first",
      "input": "{% if true %}\n{% extends \"base.html\" %}\n{% endif %}",
      "expectedErrors": ["{% extends %} must be the first tag"]
    },
    {
      "name": "Tag after extends",
      "input": "{% extends \"base.html\" %}\n{% if true %}\n{% include \"other.html\" %}\n{% endif %}",
      "expectedErrors": []
    }
  ]
}
